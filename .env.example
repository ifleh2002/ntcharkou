# --- Application ----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Emails (optionnel, utilise par l'Edge Function notify) ---------------
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=notifications@example.ma
